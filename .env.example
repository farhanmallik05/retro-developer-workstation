# =================================================================
# FARHAN MALLIK WORKSTATION ENVIRONMENT CONFIGURATION
# =================================================================

# AWS Region & Bedrock AI Twin Model ID
VITE_AWS_REGION=us-east-1
VITE_BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# Cognito Identity Pool (For direct browser-to-Bedrock invocation)
VITE_AWS_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Outbox DynamoDB Message Sink (Optional - defaults to resilient LocalStorage queue)
VITE_DYNAMODB_MESSAGE_TABLE=BuilderPortfolioMessages

